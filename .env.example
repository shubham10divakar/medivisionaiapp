# Copy to .env. EXPO_PUBLIC_* vars are inlined into the JS bundle at build time.

# Base URL of the MediVision backend gateway. The app calls ${API_URL}/models
# and ${API_URL}/predict. nginx on this host injects the X-API-Key server-side,
# so there is no secret to put here. Users can override it in Settings.
EXPO_PUBLIC_API_URL=https://medivisionai.in/api
